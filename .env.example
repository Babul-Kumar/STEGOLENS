# StegoLens Environment Variables Example
PORT=5000
NODE_ENV=development

# Python executable (use 'python' for Windows, 'python3' for Linux/macOS)
PYTHON_BIN=python

# Upload limits (in bytes, default 15MB)
UPLOAD_MAX_SIZE=15728640

# Database Configuration (Optional for SQLite local, required for PostgreSQL production)
# DATABASE_URL=postgresql://user:password@localhost:5432/stegolens

# Security & Sessions
AUTH_SECRET=change-this-to-a-secure-random-secret-in-production

# ML Inference Service (Optional Kaggle / FastAPI endpoint for ALASKA2 EfficientNet-B0)
# ML_SERVICE_URL=http://localhost:8000/predict

# Allowed CORS origin in production
FRONTEND_URL=http://localhost:5000
